# SentinelMesh environment configuration template.
# Copy to `.env` for local development. NEVER commit `.env`.
# Every service loads a typed, validated configuration object at startup
# (see packages/common-py). Unknown/missing REQUIRED values must fail fast.
#
# Legend:  [required]  must be set or the service refuses to start
#          [optional]  has a safe default
#          [secret]    never logged, never echoed, redacted in error output

# ============================================================
# Runtime
# ============================================================
SM_ENV=local                       # [required] one of: local | ci | staging | production
SM_LOG_LEVEL=INFO                  # [optional] DEBUG | INFO | WARNING | ERROR
SM_LOG_FORMAT=json                 # [optional] json | console
SM_SERVICE_NAME=                   # [required per service] e.g. ingestion-gateway
SM_DEPLOYMENT_PROFILE=monolith     # [optional] monolith | distributed

# ============================================================
# PostgreSQL (relational system of record)
# ============================================================
SM_PG_HOST=localhost              # [required]
SM_PG_PORT=5432                   # [optional]
SM_PG_DB=sentinelmesh             # [required]
SM_PG_USER=sentinelmesh           # [required]
SM_PG_PASSWORD=                   # [required][secret]
SM_PG_POOL_MIN=1                  # [optional]
SM_PG_POOL_MAX=10                 # [optional]
SM_PG_STATEMENT_TIMEOUT_MS=15000  # [optional]

# ============================================================
# Neo4j (attack graph + knowledge graph)
# ============================================================
SM_NEO4J_URI=bolt://localhost:7687   # [required]
SM_NEO4J_USER=neo4j                  # [required]
SM_NEO4J_PASSWORD=                   # [required][secret]
SM_NEO4J_DATABASE=neo4j              # [optional] single db on Community
SM_NEO4J_QUERY_TIMEOUT_MS=10000      # [optional] per-query timeout; slow query raises, never hangs
SM_NEO4J_QUERY_MAX_ROWS=1000         # [optional] row cap on every graph-query API response
SM_NEO4J_TRAVERSAL_MAX_DEPTH=8       # [optional] hard cap on traversal depth (query API clamps to this)

# ============================================================
# Kafka (durable canonical event bus)
# ============================================================
SM_KAFKA_BOOTSTRAP_SERVERS=localhost:19092  # [required] compose redpanda EXTERNAL listener; containers use redpanda:9092
SM_KAFKA_SECURITY_PROTOCOL=PLAINTEXT        # [optional] PLAINTEXT | SASL_SSL
SM_KAFKA_SASL_USERNAME=                     # [optional]
SM_KAFKA_SASL_PASSWORD=                     # [optional][secret]
SM_KAFKA_CLIENT_ID=                         # [optional]
SM_KAFKA_CONSUMER_GROUP=                    # [required per consumer]
SM_KAFKA_SEND_TIMEOUT_MS=10000              # [optional] producer request timeout
SM_KAFKA_LINGER_MS=5                        # [optional] producer batching linger
SM_KAFKA_MAX_POLL_RECORDS=200               # [optional] consumer records per poll (backpressure bound)
SM_KAFKA_SHUTDOWN_GRACE_MS=15000            # [optional] consumer drains the in-flight batch within this on stop
SM_KAFKA_HANDLER_MAX_ATTEMPTS=3             # [optional] in-process retries before DLQ (event-model.md §4)
SM_EVENT_BUS_ENABLED=false                  # [optional] true = producing services open a Kafka producer; false = logging stopgap sink

# ============================================================
# Redis (cache + ephemeral state + WebSocket fanout — NOT durable bus)
# ============================================================
SM_REDIS_URL=redis://localhost:6379/0   # [required]
SM_REDIS_PASSWORD=                       # [optional][secret]
SM_REDIS_KEY_PREFIX=sm                   # [optional]

# ============================================================
# Object store (model artifacts, Flink checkpoints, reports) — S3 compatible
# ============================================================
SM_S3_ENDPOINT=http://localhost:9000    # [required]
SM_S3_REGION=us-east-1                  # [optional]
SM_S3_ACCESS_KEY_ID=                    # [required][secret]
SM_S3_SECRET_ACCESS_KEY=               # [required][secret]
SM_S3_BUCKET_ARTIFACTS=sm-artifacts     # [required]
SM_S3_BUCKET_REPORTS=sm-reports         # [required]

# ============================================================
# MLflow (experiment tracking + model registry)
# ============================================================
SM_MLFLOW_TRACKING_URI=http://localhost:5000   # [required for ml-* services]

# ============================================================
# Authentication / SSO (OIDC)
# ============================================================
SM_OIDC_ISSUER=http://localhost:8080/realms/sentinelmesh   # [required]
SM_OIDC_CLIENT_ID=sentinelmesh-api                         # [required]
SM_OIDC_CLIENT_SECRET=                                     # [required][secret]
SM_OIDC_AUDIENCE=sentinelmesh                              # [required]
SM_JWT_LEEWAY_SECONDS=30                                   # [optional]
SM_SESSION_COOKIE_SECURE=true                              # [optional] must be true in production
SM_SESSION_COOKIE_NAME=sm_session                          # [optional]
SM_CSRF_COOKIE_NAME=sm_csrf                                # [optional] readable by JS (double-submit)
SM_SESSION_IDLE_SECONDS=3600                               # [optional]
SM_SESSION_ABSOLUTE_SECONDS=43200                          # [optional] must be >= idle
SM_OIDC_STATE_TTL_SECONDS=600                              # [optional]
SM_LOGIN_MAX_FAILURES=10                                   # [optional] local-login lockout threshold
SM_LOGIN_LOCKOUT_SECONDS=900                               # [optional] local-login lockout duration

# ============================================================
# Service-to-service auth
# ============================================================
SM_INTERNAL_JWT_SIGNING_KEY=          # [required][secret] symmetric key or path to private key
SM_INTERNAL_JWT_TTL_SECONDS=300       # [optional]

# ============================================================
# LLM providers (AI analyst / agents / NL hunting / storytelling / RCA)
# ============================================================
SM_LLM_DEFAULT_PROVIDER=anthropic     # [required] anthropic | openai | local | deterministic
SM_LLM_DEFAULT_MODEL=                 # [required] pin at implementation; see docs/ARCHITECTURE_DECISIONS.md ADR-014
SM_LLM_API_KEY=                       # [optional][secret] unset -> the HTTP adapter is inert, AI layer uses deterministic templates
SM_LLM_BASE_URL=                      # [optional] override the provider base URL (e.g. a local OpenAI-compatible server)
SM_LLM_MAX_PROMPT_TOKENS=24000        # [optional] per-call prompt ceiling; a larger request is rejected before any network call
SM_LLM_MAX_OUTPUT_TOKENS=2048         # [optional]
SM_LLM_MAX_RETRIES=2                  # [optional] transient-only; a provider policy refusal is never retried
SM_LLM_REQUEST_TIMEOUT_S=60           # [optional]
SM_LLM_TOOL_MODE=constrained          # [optional] constrained | off  (never "unrestricted")

# ---- agent orchestration ceilings (Phase 10) ----
SM_AGENT_MAX_STEPS=12                 # [optional] hard cap on reasoning steps in one agent run
SM_AGENT_MAX_TOOL_CALLS=24            # [optional] hard cap on tool invocations in one agent run
SM_AGENT_WALL_CLOCK_TIMEOUT_S=120     # [optional] a run is cancelled past this
SM_AGENT_MAX_LLM_TOKENS_PER_RUN=60000 # [optional] cumulative token budget for one run

# ============================================================
# Threat intelligence + MITRE ATT&CK (Phase 6)
# ============================================================
SM_TI_PROVIDERS=                     # [optional] comma list: fixture,abusech,otx  (empty = no outbound calls)
SM_TI_ABUSECH_URL=                   # [optional] URLhaus recent-URLs endpoint override
SM_TI_OTX_URL=                       # [optional] OTX subscribed-pulses endpoint override
SM_TI_OTX_KEY=                       # [optional][secret] AlienVault OTX API key (only read if 'otx' is in SM_TI_PROVIDERS)
SM_TI_HTTP_TIMEOUT_S=10              # [optional]
SM_TI_HTTP_MAX_RETRIES=2             # [optional]
SM_TI_DEFAULT_TTL_SECONDS=86400      # [optional] indicator freshness TTL
SM_TI_EXPIRY_SWEEP_SECONDS=900       # [optional] background expiry sweep interval
SM_TI_POLL_SECONDS=3600              # [optional] provider poll interval
SM_TI_SERVICE_URL=http://localhost:8007   # [optional] threat-intel-service base URL (used by normalization-engine enrichment)
SM_MITRE_SERVICE_URL=http://localhost:8008 # [optional]
SM_MITRE_EXPECTED_MATRIX_VERSION=   # [optional] if set, /readyz checks the imported catalog matches
SM_TI_ENRICHMENT_ENABLED=false      # [optional] normalization-engine calls threat-intel-service per event

# ============================================================
# ML / GNN + temporal intelligence (Phase 8)
# ============================================================
SM_ML_SEED=1337                      # [optional] global seed for reproducible ML pipelines
SM_ML_GRAPH_MODEL_DIR=ml/artifacts/graph  # [optional] GNN checkpoint directory (empty -> structural path only)
SM_GRAPH_ANOMALY_Z=3.5              # [optional] structural graph-anomaly z-threshold
SM_TEMPORAL_MAX_CLOCK_SKEW_SECONDS=300     # [optional] bound on a source clock running ahead of ingest
SM_TEMPORAL_SESSION_LINK_SECONDS=3600      # [optional] max gap to stitch two sessions of one entity

# ============================================================
# Attack-chain correlation + threat scoring (Phase 7)
# ============================================================
SM_CORRELATION_ENGINE_URL=http://localhost:8009  # [optional]
SM_GRAPH_SERVICE_URL=http://localhost:8004        # [optional] api-gateway SOC BFF -> graph-service
SM_CHAIN_WINDOW_SECONDS=86400        # [optional] tumbling window: detections about one subject in one window form one chain
SM_CHAIN_DORMANT_SECONDS=21600       # [optional] a chain with no new evidence for this long is marked 'dormant'
SM_CHAIN_SCORE_ALERT_THRESHOLD=0.75  # [optional] chain score at/above this is worth surfacing

# ============================================================
# Enrichment
# ============================================================
SM_GEOIP_DB_PATH=                    # [optional] path to MaxMind GeoLite2-City.mmdb; enrichment degrades if unset

# ============================================================
# Observability
# ============================================================
SM_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317   # [optional]
SM_OTEL_TRACES_ENABLED=true                            # [optional]
SM_PROMETHEUS_METRICS_PORT=9464                        # [optional]

# ============================================================
# HTTP hardening (api-gateway / ingestion-gateway)
# ============================================================
SM_HTTP_MAX_BODY_BYTES=1048576        # [optional] 1 MiB default
SM_HTTP_REQUEST_TIMEOUT_S=30          # [optional]
SM_CORS_ALLOWED_ORIGINS=http://localhost:3000   # [required] comma-separated, no wildcard in production
SM_RATE_LIMIT_PER_MINUTE=120          # [optional]
SM_TRUSTED_PROXY_HOPS=0               # [optional] proxies in front of the service; 0 = ignore X-Forwarded-For

# ============================================================
# Ingestion gateway (Phase 2)
# ============================================================
SM_INGEST_DEDUP_TTL_SECONDS=900       # [optional] X-Sensor-Event-Id remembered this long
SM_INGEST_BATCH_MAX_EVENTS=500        # [optional] max events in one /api/v1/ingest/batch

# ============================================================
# Autonomous response safety (agent-orchestrator)
# ============================================================
SM_RESPONSE_MODE=suggest_only         # [required] suggest_only | approve_required | auto  (auto forbidden outside production w/ policy)
SM_RESPONSE_APPROVAL_REQUIRED=true    # [optional]

# ============================================================
# Benchmark datasets (evaluation only — data is outside the repo)
# ============================================================
SM_DATASET_ROOT=C:\Sentinel_Mesh      # [optional] absolute path to staged datasets
