{
  "title": "SentinelMesh — Platform Overview",
  "uid": "sm-platform-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "tags": ["sentinelmesh", "adr-020"],
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (service) (rate(sm_http_requests_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p95 latency by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(sm_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Dependency health (1 = reachable)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "sm_dependency_up",
          "legendFormat": "{{service}} / {{dependency}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Kafka consumer lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sm_consumer_lag",
          "legendFormat": "{{service}} / {{group}} / {{topic}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Dead-lettered records (5m rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (service, group, reason) (rate(sm_consumer_dlq_total[5m]))",
          "legendFormat": "{{service}} / {{group}} / {{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Postgres pool utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sm_db_pool_checked_out / sm_db_pool_size",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Neo4j query latency (p95, graph-service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (mode, le) (rate(sm_neo4j_query_duration_seconds_bucket[5m])))",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Graph growth rate (writes/sec, by op)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum by (op, outcome) (rate(sm_graph_commands_applied_total[5m]))",
          "legendFormat": "{{op}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Detection pipeline latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sm_detection_handle_seconds_bucket[5m])))",
          "legendFormat": "detection-engine"
        }
      ]
    },
    {
      "id": 10,
      "title": "Detection scoring degraded (5m rate, by reason)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "sum by (reason) (rate(sm_detection_degraded_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Model inference latency (p95, by model)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (model, le) (rate(sm_inference_duration_seconds_bucket[5m])))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Rate-limited requests (5m rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        {
          "expr": "sum by (service) (rate(sm_rate_limited_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Authn failures / authz denials (5m rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "targets": [
        {
          "expr": "sum by (service) (rate(sm_authn_failures_total[5m]))",
          "legendFormat": "authn failures — {{service}}"
        },
        {
          "expr": "sum by (service) (rate(sm_authz_denials_total[5m]))",
          "legendFormat": "authz denials — {{service}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Audit write failures (any non-zero needs investigation)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "targets": [
        {
          "expr": "sum by (service, action) (rate(sm_audit_write_failures_total[5m]))",
          "legendFormat": "{{service}} / {{action}}"
        }
      ]
    }
  ]
}
