{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "One piece of platform-gathered evidence. `trusted` is `True` only for\nstrings SentinelMesh itself produced (a rule id, a numeric score, a catalog\ntechnique id); everything telemetry- or third-party-derived is `False` and is\nfenced as data before it reaches the model.",
      "properties": {
        "content": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "kind": {
          "maxLength": 48,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "ref": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "trusted": {
          "default": false,
          "title": "Trusted",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "ref",
        "provenance",
        "content"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "subject_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "subject_type": {
      "enum": [
        "detection",
        "attack_chain",
        "incident"
      ],
      "title": "Subject Type",
      "type": "string"
    },
    "task": {
      "default": "summarize",
      "enum": [
        "summarize",
        "triage",
        "reason",
        "remediate"
      ],
      "title": "Task",
      "type": "string"
    }
  },
  "required": [
    "subject_type",
    "subject_id",
    "evidence"
  ],
  "title": "ExplainRequest",
  "type": "object",
  "x-sentinelmesh-contracts-version": "0.1.0"
}
