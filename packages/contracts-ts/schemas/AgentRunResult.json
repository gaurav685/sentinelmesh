{
  "$defs": {
    "AgentFinding": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Evidence Refs",
          "type": "array"
        },
        "kind": {
          "maxLength": 48,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "summary"
      ],
      "title": "AgentFinding",
      "type": "object"
    },
    "ProposedActionOut": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Action Type",
          "type": "string"
        },
        "decision": {
          "default": "approval_required",
          "enum": [
            "denied",
            "approval_required",
            "allowed"
          ],
          "title": "Decision",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "maxLength": 2000,
          "title": "Rationale",
          "type": "string"
        },
        "reversible": {
          "default": true,
          "title": "Reversible",
          "type": "boolean"
        },
        "target": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "action_type",
        "target"
      ],
      "title": "ProposedActionOut",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent": {
      "enum": [
        "detection-agent",
        "threat-intel-agent",
        "response-orchestration-agent"
      ],
      "title": "Agent",
      "type": "string"
    },
    "detail": {
      "default": "",
      "maxLength": 300,
      "title": "Detail",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/AgentFinding"
      },
      "maxItems": 100,
      "title": "Findings",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "proposed_actions": {
      "items": {
        "$ref": "#/$defs/ProposedActionOut"
      },
      "maxItems": 50,
      "title": "Proposed Actions",
      "type": "array"
    },
    "status": {
      "enum": [
        "completed",
        "cancelled",
        "timeout",
        "step_limit",
        "tool_limit",
        "budget_exhausted",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "steps_used": {
      "minimum": 0,
      "title": "Steps Used",
      "type": "integer"
    },
    "tokens_spent": {
      "minimum": 0,
      "title": "Tokens Spent",
      "type": "integer"
    },
    "tool_calls_used": {
      "minimum": 0,
      "title": "Tool Calls Used",
      "type": "integer"
    }
  },
  "required": [
    "agent",
    "status",
    "steps_used",
    "tool_calls_used",
    "tokens_spent",
    "generated_at"
  ],
  "title": "AgentRunResult",
  "type": "object",
  "x-sentinelmesh-contracts-version": "0.1.0"
}
