{
  "$defs": {
    "CanonicalEventPayload": {
      "additionalProperties": false,
      "description": "The normalized view of one telemetry event. Written by\n`normalization-engine`, consumed by the graph, detection and memory\nsubsystems.",
      "properties": {
        "action": {
          "description": "Normalized verb, e.g. 'connected_to'.",
          "maxLength": 64,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "anyOf": [
            {
              "$ref": "#/definitions/EntityRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Entity that initiated the event."
        },
        "attributes": {
          "additionalProperties": true,
          "description": "Normalized flat attributes (ports, bytes, query name, \u2026).",
          "title": "Attributes",
          "type": "object"
        },
        "enrichment": {
          "additionalProperties": true,
          "description": "Enrichment results keyed by provider, each carrying its own provenance and freshness. Absent or partial when a provider was unavailable.",
          "title": "Enrichment",
          "type": "object"
        },
        "entities": {
          "items": {
            "$ref": "#/definitions/EntityRef"
          },
          "maxItems": 64,
          "title": "Entities",
          "type": "array"
        },
        "kind": {
          "$ref": "#/definitions/CanonicalKind"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "raw_event_id": {
          "description": "The telemetry.raw event this was derived from (lineage).",
          "format": "uuid",
          "title": "Raw Event Id",
          "type": "string"
        },
        "raw_event_type": {
          "$ref": "#/definitions/EventType"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/definitions/EntityRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Entity acted upon."
        }
      },
      "required": [
        "kind",
        "occurred_at",
        "action",
        "raw_event_id",
        "raw_event_type"
      ],
      "title": "CanonicalEventPayload",
      "type": "object"
    },
    "CanonicalKind": {
      "enum": [
        "network_flow",
        "auth",
        "dns",
        "process_exec",
        "file_access"
      ],
      "title": "CanonicalKind",
      "type": "string"
    },
    "EntityKind": {
      "enum": [
        "identity",
        "host",
        "ip",
        "domain",
        "process",
        "file"
      ],
      "title": "EntityKind",
      "type": "string"
    },
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/definitions/EntityKind"
        },
        "value": {
          "description": "Canonical identifier for the entity.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "EventSource": {
      "additionalProperties": false,
      "properties": {
        "sensor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensor Id"
        },
        "site": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site"
        },
        "type": {
          "$ref": "#/definitions/SourceType"
        }
      },
      "required": [
        "type"
      ],
      "title": "EventSource",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "telemetry.network_flow",
        "telemetry.auth_event",
        "telemetry.dns_query",
        "telemetry.process_exec",
        "telemetry.file_access",
        "event.canonical",
        "graph.command",
        "graph.event",
        "detection.raised",
        "attack_chain.updated",
        "ti.indicator_updated",
        "agent.task",
        "response.action",
        "campaign.updated",
        "report.generated",
        "user.event"
      ],
      "title": "EventType",
      "type": "string"
    },
    "SourceType": {
      "enum": [
        "sensor",
        "deception",
        "simulation",
        "internal"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "description": "Globally unique, time-ordered (UUIDv7). Idempotency key.",
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/definitions/EventType"
    },
    "event_version": {
      "description": "Schema version of `payload`.",
      "minimum": 1,
      "title": "Event Version",
      "type": "integer"
    },
    "ingested_at": {
      "description": "Set by ingestion-gateway on receipt. UTC.",
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Non-authoritative annotations (enrichment provenance, tags).",
      "title": "Metadata",
      "type": "object"
    },
    "occurred_at": {
      "description": "Event time, from the source. UTC.",
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "partition_key": {
      "description": "Derived (tenant + primary entity). Controls ordering.",
      "maxLength": 128,
      "minLength": 1,
      "title": "Partition Key",
      "type": "string"
    },
    "payload": {
      "$ref": "#/definitions/CanonicalEventPayload"
    },
    "producer": {
      "description": "`<service>@<semver>`, e.g. ingestion-gateway@0.1.0",
      "title": "Producer",
      "type": "string"
    },
    "source": {
      "$ref": "#/definitions/EventSource"
    },
    "tenant_id": {
      "description": "Set from the authenticated producer context, never trusted from input.",
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "W3C trace-context trace-id.",
      "title": "Trace Id"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "ingested_at",
    "producer",
    "tenant_id",
    "source",
    "correlation_id",
    "partition_key",
    "payload"
  ],
  "title": "EventEnvelope[CanonicalEventPayload]",
  "type": "object",
  "x-sentinelmesh-contracts-version": "0.1.0"
}
