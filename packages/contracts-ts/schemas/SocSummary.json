{
  "$defs": {
    "RiskSubject": {
      "additionalProperties": false,
      "properties": {
        "computed_at": {
          "format": "date-time",
          "title": "Computed At",
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "scoring_status": {
          "$ref": "#/$defs/ScoringStatus"
        },
        "subject_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "subject_type": {
          "$ref": "#/$defs/ThreatSubjectType"
        }
      },
      "required": [
        "subject_type",
        "subject_id",
        "score",
        "scoring_status",
        "computed_at"
      ],
      "title": "RiskSubject",
      "type": "object"
    },
    "ScoringStatus": {
      "description": "ADR-013: a model timeout / outage degrades the score, never drops it.",
      "enum": [
        "ok",
        "degraded"
      ],
      "title": "ScoringStatus",
      "type": "string"
    },
    "ThreatSubjectType": {
      "enum": [
        "identity",
        "host",
        "ip",
        "domain",
        "detection"
      ],
      "title": "ThreatSubjectType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The dashboard's top-of-page counters. Every number is a real row count for\nthe caller's tenant \u2014 never a fabricated figure.",
  "properties": {
    "active_chains": {
      "minimum": 0,
      "title": "Active Chains",
      "type": "integer"
    },
    "alerts_by_severity": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Alerts By Severity",
      "type": "object"
    },
    "detections_24h": {
      "minimum": 0,
      "title": "Detections 24H",
      "type": "integer"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "open_alerts": {
      "minimum": 0,
      "title": "Open Alerts",
      "type": "integer"
    },
    "top_risk_subjects": {
      "items": {
        "$ref": "#/$defs/RiskSubject"
      },
      "maxItems": 20,
      "title": "Top Risk Subjects",
      "type": "array"
    }
  },
  "required": [
    "generated_at",
    "open_alerts",
    "active_chains",
    "detections_24h"
  ],
  "title": "SocSummary",
  "type": "object",
  "x-sentinelmesh-contracts-version": "0.1.0"
}
