{
  "$defs": {
    "EntitySelector": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "identity",
            "host",
            "ip",
            "domain",
            "process",
            "file",
            "detection",
            "attack_chain",
            "attack_technique",
            "threat_actor",
            "campaign"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "EntitySelector",
      "type": "object"
    },
    "HuntResult": {
      "additionalProperties": false,
      "properties": {
        "cypher_fingerprint": {
          "default": "",
          "maxLength": 64,
          "title": "Cypher Fingerprint",
          "type": "string"
        },
        "explanation": {
          "default": "",
          "maxLength": 4000,
          "title": "Explanation",
          "type": "string"
        },
        "intent": {
          "enum": [
            "find_entity",
            "list_related",
            "path_between",
            "detections_for",
            "chains_for",
            "indicator_sightings",
            "technique_usage"
          ],
          "title": "Intent",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/QueryPlan"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "rows": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 500,
          "title": "Rows",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "intent",
        "plan",
        "row_count"
      ],
      "title": "HuntResult",
      "type": "object"
    },
    "HuntTimeRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "title": "HuntTimeRange",
      "type": "object"
    },
    "QueryLimits": {
      "additionalProperties": false,
      "properties": {
        "max_depth": {
          "default": 2,
          "maximum": 4,
          "minimum": 1,
          "title": "Max Depth",
          "type": "integer"
        },
        "max_rows": {
          "default": 100,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Rows",
          "type": "integer"
        }
      },
      "title": "QueryLimits",
      "type": "object"
    },
    "QueryPlan": {
      "additionalProperties": false,
      "description": "A validated, capability-bounded hunt request. Deterministically compiled\nto a parameterized Cypher template by `graph-service` \u2014 never executed as\nfree text.",
      "properties": {
        "intent": {
          "enum": [
            "find_entity",
            "list_related",
            "path_between",
            "detections_for",
            "chains_for",
            "indicator_sightings",
            "technique_usage"
          ],
          "title": "Intent",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/QueryLimits"
        },
        "rel_types": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Rel Types",
          "type": "array"
        },
        "selectors": {
          "items": {
            "$ref": "#/$defs/EntitySelector"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Selectors",
          "type": "array"
        },
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/HuntTimeRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "intent",
        "selectors"
      ],
      "title": "QueryPlan",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "history_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "History Id"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/HuntResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "supported": {
      "title": "Supported",
      "type": "boolean"
    },
    "unsupported_reason": {
      "default": "",
      "maxLength": 300,
      "title": "Unsupported Reason",
      "type": "string"
    }
  },
  "required": [
    "supported"
  ],
  "title": "SocHuntResponse",
  "type": "object",
  "x-sentinelmesh-contracts-version": "0.1.0"
}
