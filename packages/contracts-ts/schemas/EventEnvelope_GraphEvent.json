{
  "$defs": {
    "EventSource": {
      "additionalProperties": false,
      "properties": {
        "sensor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensor Id"
        },
        "site": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        }
      },
      "required": [
        "type"
      ],
      "title": "EventSource",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "telemetry.network_flow",
        "telemetry.auth_event",
        "telemetry.dns_query",
        "telemetry.process_exec",
        "telemetry.file_access",
        "event.canonical",
        "graph.command",
        "graph.event",
        "detection.raised",
        "attack_chain.updated",
        "ti.indicator_updated",
        "agent.task",
        "response.action",
        "campaign.updated",
        "report.generated",
        "user.event"
      ],
      "title": "EventType",
      "type": "string"
    },
    "GraphEventPayload": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "description": "The `graph.commands` command this reports on.",
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "label": {
          "description": "Node label or relationship type.",
          "maxLength": 64,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "nodes_written": {
          "default": 0,
          "minimum": 0,
          "title": "Nodes Written",
          "type": "integer"
        },
        "observed_at": {
          "description": "Event time carried from the command. UTC.",
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/GraphOp"
        },
        "outcome": {
          "$ref": "#/$defs/GraphMutationOutcome"
        },
        "raw_event_id": {
          "description": "Lineage \u2014 the source telemetry/detection event.",
          "format": "uuid",
          "title": "Raw Event Id",
          "type": "string"
        },
        "relationships_written": {
          "default": 0,
          "minimum": 0,
          "title": "Relationships Written",
          "type": "integer"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "op",
        "outcome",
        "tenant_id",
        "observed_at",
        "raw_event_id",
        "label"
      ],
      "title": "GraphEventPayload",
      "type": "object"
    },
    "GraphMutationOutcome": {
      "enum": [
        "APPLIED",
        "DUPLICATE",
        "STALE"
      ],
      "title": "GraphMutationOutcome",
      "type": "string"
    },
    "GraphOp": {
      "enum": [
        "MERGE_NODE",
        "MERGE_EDGE",
        "SET_PROPS",
        "PRUNE"
      ],
      "title": "GraphOp",
      "type": "string"
    },
    "SourceType": {
      "enum": [
        "sensor",
        "deception",
        "simulation",
        "internal"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "description": "Globally unique, time-ordered (UUIDv7). Idempotency key.",
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "event_version": {
      "description": "Schema version of `payload`.",
      "minimum": 1,
      "title": "Event Version",
      "type": "integer"
    },
    "ingested_at": {
      "description": "Set by ingestion-gateway on receipt. UTC.",
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Non-authoritative annotations (enrichment provenance, tags).",
      "title": "Metadata",
      "type": "object"
    },
    "occurred_at": {
      "description": "Event time, from the source. UTC.",
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "partition_key": {
      "description": "Derived (tenant + primary entity). Controls ordering.",
      "maxLength": 128,
      "minLength": 1,
      "title": "Partition Key",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/GraphEventPayload"
    },
    "producer": {
      "description": "`<service>@<semver>`, e.g. ingestion-gateway@0.1.0",
      "title": "Producer",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/EventSource"
    },
    "tenant_id": {
      "description": "Set from the authenticated producer context, never trusted from input.",
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "W3C trace-context trace-id.",
      "title": "Trace Id"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "ingested_at",
    "producer",
    "tenant_id",
    "source",
    "correlation_id",
    "partition_key",
    "payload"
  ],
  "title": "EventEnvelope[GraphEventPayload]",
  "type": "object",
  "x-sentinelmesh-contracts-version": "0.1.0"
}
