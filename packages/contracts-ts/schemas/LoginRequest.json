{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Local fallback login. Federated users authenticate via OIDC instead.\n\n`tenant_slug` disambiguates the account; the server still resolves the tenant\nserver-side and never trusts a tenant id from the client.",
  "properties": {
    "email": {
      "format": "email",
      "title": "Email",
      "type": "string"
    },
    "password": {
      "format": "password",
      "maxLength": 1024,
      "minLength": 1,
      "title": "Password",
      "type": "string",
      "writeOnly": true
    },
    "tenant_slug": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Tenant Slug",
      "type": "string"
    }
  },
  "required": [
    "tenant_slug",
    "email",
    "password"
  ],
  "title": "LoginRequest",
  "type": "object",
  "x-sentinelmesh-contracts-version": "0.1.0"
}
