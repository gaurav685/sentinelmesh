{
  "$defs": {
    "AttackStage": {
      "description": "Kill-chain stage, one per enterprise ATT&CK tactic, in kill-chain order.\n\n`unknown` is a real, first-class value: a detection whose techniques the\nplatform cannot place goes here rather than being forced onto a stage.",
      "enum": [
        "reconnaissance",
        "resource_development",
        "initial_access",
        "execution",
        "persistence",
        "privilege_escalation",
        "defense_evasion",
        "credential_access",
        "discovery",
        "lateral_movement",
        "collection",
        "command_and_control",
        "exfiltration",
        "impact",
        "unknown"
      ],
      "title": "AttackStage",
      "type": "string"
    },
    "ChainStatus": {
      "description": "Lifecycle of a chain's *evidence* \u2014 not an analyst verdict.\n\nA chain is never automatically `confirmed`; confirmation is a human action on\nthe alert/investigation layer (Constitution \u00a717), not something the\ncorrelator asserts.",
      "enum": [
        "forming",
        "active",
        "dormant"
      ],
      "title": "ChainStatus",
      "type": "string"
    },
    "ScoringStatus": {
      "description": "ADR-013: a model timeout / outage degrades the score, never drops it.",
      "enum": [
        "ok",
        "degraded"
      ],
      "title": "ScoringStatus",
      "type": "string"
    },
    "ThreatSubjectType": {
      "enum": [
        "identity",
        "host",
        "ip",
        "domain",
        "detection"
      ],
      "title": "ThreatSubjectType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`attack_chains` topic event (`EventType.attack_chain_updated`).\n\nThin projection: enough to render a chain row and to fan a notification out.\nThe per-stage evidence stays in Postgres.",
  "properties": {
    "chain_id": {
      "format": "uuid",
      "title": "Chain Id",
      "type": "string"
    },
    "confidence": {
      "maximum": 0.95,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "detection_count": {
      "minimum": 0,
      "title": "Detection Count",
      "type": "integer"
    },
    "distinct_stage_count": {
      "description": "Distinct real kill-chain stages.",
      "minimum": 0,
      "title": "Distinct Stage Count",
      "type": "integer"
    },
    "first_seen": {
      "format": "date-time",
      "title": "First Seen",
      "type": "string"
    },
    "last_seen": {
      "format": "date-time",
      "title": "Last Seen",
      "type": "string"
    },
    "latest_stage": {
      "$ref": "#/$defs/AttackStage"
    },
    "progression": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Progression",
      "type": "number"
    },
    "score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Score",
      "type": "number"
    },
    "score_version": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Score Version",
      "type": "string"
    },
    "scoring_status": {
      "$ref": "#/$defs/ScoringStatus"
    },
    "stage_count": {
      "description": "Total stage rows (includes 'unknown').",
      "minimum": 0,
      "title": "Stage Count",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/ChainStatus"
    },
    "subject_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "subject_type": {
      "$ref": "#/$defs/ThreatSubjectType"
    },
    "technique_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Technique Ids",
      "type": "array"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "ti_corroborated": {
      "default": false,
      "title": "Ti Corroborated",
      "type": "boolean"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "chain_id",
    "tenant_id",
    "subject_type",
    "subject_id",
    "status",
    "first_seen",
    "last_seen",
    "updated_at",
    "stage_count",
    "distinct_stage_count",
    "latest_stage",
    "progression",
    "confidence",
    "score",
    "score_version",
    "scoring_status",
    "detection_count"
  ],
  "title": "AttackChainPayload",
  "type": "object",
  "x-sentinelmesh-contracts-version": "0.1.0"
}
