{
  "$defs": {
    "EventSource": {
      "additionalProperties": false,
      "properties": {
        "sensor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensor Id"
        },
        "site": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site"
        },
        "type": {
          "$ref": "#/definitions/SourceType"
        }
      },
      "required": [
        "type"
      ],
      "title": "EventSource",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "telemetry.network_flow",
        "telemetry.auth_event",
        "telemetry.dns_query",
        "telemetry.process_exec",
        "telemetry.file_access",
        "event.canonical",
        "graph.command",
        "graph.event",
        "detection.raised",
        "attack_chain.updated",
        "ti.indicator_updated",
        "agent.task",
        "response.action",
        "campaign.updated",
        "report.generated",
        "user.event"
      ],
      "title": "EventType",
      "type": "string"
    },
    "IndicatorFreshness": {
      "enum": [
        "fresh",
        "aging",
        "stale",
        "expired"
      ],
      "title": "IndicatorFreshness",
      "type": "string"
    },
    "IndicatorType": {
      "enum": [
        "ipv4",
        "ipv6",
        "domain",
        "url",
        "sha256",
        "sha1",
        "md5",
        "email"
      ],
      "title": "IndicatorType",
      "type": "string"
    },
    "SourceType": {
      "enum": [
        "sensor",
        "deception",
        "simulation",
        "internal"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "TiConfidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "TiConfidence",
      "type": "string"
    },
    "TiUpdateAction": {
      "enum": [
        "added",
        "updated",
        "expired"
      ],
      "title": "TiUpdateAction",
      "type": "string"
    },
    "TiUpdatePayload": {
      "additionalProperties": false,
      "description": "`ti.updates` topic event (`EventType.ti_indicator_updated`).",
      "properties": {
        "action": {
          "$ref": "#/definitions/TiUpdateAction"
        },
        "confidence": {
          "$ref": "#/definitions/TiConfidence"
        },
        "freshness": {
          "$ref": "#/definitions/IndicatorFreshness"
        },
        "indicator_id": {
          "format": "uuid",
          "title": "Indicator Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "tenant_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant Id"
        },
        "type": {
          "$ref": "#/definitions/IndicatorType"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "indicator_id",
        "type",
        "value",
        "source",
        "action",
        "confidence",
        "freshness",
        "observed_at"
      ],
      "title": "TiUpdatePayload",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "description": "Globally unique, time-ordered (UUIDv7). Idempotency key.",
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/definitions/EventType"
    },
    "event_version": {
      "description": "Schema version of `payload`.",
      "minimum": 1,
      "title": "Event Version",
      "type": "integer"
    },
    "ingested_at": {
      "description": "Set by ingestion-gateway on receipt. UTC.",
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Non-authoritative annotations (enrichment provenance, tags).",
      "title": "Metadata",
      "type": "object"
    },
    "occurred_at": {
      "description": "Event time, from the source. UTC.",
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "partition_key": {
      "description": "Derived (tenant + primary entity). Controls ordering.",
      "maxLength": 128,
      "minLength": 1,
      "title": "Partition Key",
      "type": "string"
    },
    "payload": {
      "$ref": "#/definitions/TiUpdatePayload"
    },
    "producer": {
      "description": "`<service>@<semver>`, e.g. ingestion-gateway@0.1.0",
      "title": "Producer",
      "type": "string"
    },
    "source": {
      "$ref": "#/definitions/EventSource"
    },
    "tenant_id": {
      "description": "Set from the authenticated producer context, never trusted from input.",
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "W3C trace-context trace-id.",
      "title": "Trace Id"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "ingested_at",
    "producer",
    "tenant_id",
    "source",
    "correlation_id",
    "partition_key",
    "payload"
  ],
  "title": "EventEnvelope[TiUpdatePayload]",
  "type": "object",
  "x-sentinelmesh-contracts-version": "0.1.0"
}
