{
  "$defs": {
    "ThreatSubjectType": {
      "enum": [
        "identity",
        "host",
        "ip",
        "domain",
        "detection"
      ],
      "title": "ThreatSubjectType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A behavioral pattern observed for one subject \u2014 upserted as the\nsubject's technique set grows, never duplicated per occurrence.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "first_seen": {
      "format": "date-time",
      "title": "First Seen",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "last_seen": {
      "format": "date-time",
      "title": "Last Seen",
      "type": "string"
    },
    "occurrence_count": {
      "minimum": 1,
      "title": "Occurrence Count",
      "type": "integer"
    },
    "pattern_kind": {
      "const": "technique_sequence",
      "title": "Pattern Kind",
      "type": "string"
    },
    "source": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "subject_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "subject_type": {
      "$ref": "#/$defs/ThreatSubjectType"
    },
    "technique_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 200,
      "title": "Technique Ids",
      "type": "array"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "tenant_id",
    "id",
    "subject_type",
    "subject_id",
    "pattern_kind",
    "occurrence_count",
    "first_seen",
    "last_seen",
    "source"
  ],
  "title": "ThreatMemory",
  "type": "object",
  "x-sentinelmesh-contracts-version": "0.1.0"
}
