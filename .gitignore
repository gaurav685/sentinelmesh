# --- Secrets / environment ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*_rsa
secrets/
.secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

# --- Generated code (regenerated by scripts/gen_contracts.py) ---
# Both the JSON Schema (packages/contracts-ts/schemas/) and the TypeScript it
# produces (packages/contracts-ts/src/) ARE committed: the frontend imports the
# generated types, and CI diffs them to catch staleness. Do not hand-edit either.
packages/contracts-ts/schemas/_combined.schema.json

# --- Node / frontend ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
coverage/
.pnpm-store/

# --- ML artifacts / data ---
mlruns/
mlartifacts/
*.pt
*.pth
*.onnx
*.pkl
*.joblib
# LightGBM's own text save format -- same "reproduce via training script,
# never commit the binary" convention as *.joblib/*.pt above. Scoped to
# ml/artifacts specifically, not a blanket *.txt (too generic repo-wide).
ml/artifacts/**/model.txt
ml/datasets/**/data/
ml/notebooks/**/*.ipynb_checkpoints/
# Benchmark datasets live outside the repo (C:\Sentinel_Mesh). Never commit them.
# Anchored to the repo root so it does NOT also match ml/datasets/<name>/ —
# that directory holds committed adapters + MANIFEST.md (R24), never raw data
# (ml/datasets/**/data/ above already excludes any raw data placed under it).
/datasets/
*.pcap
*.binetflow
*.jsonl
*.arff

# Phase 1 (modern flow datasets): raw downloads and derived Parquet are never
# committed -- data/metadata/ (checksums, row counts, schema notes) IS
# committed, so leave that one out of this ignore. A blanket `*.csv` would
# also catch the small, real, intentionally-committed synthetic test
# fixtures under packages/ml-py/tests/fixtures/ -- scoped to /data/ instead.
/data/raw/
/data/processed/
*.parquet

# --- Infra / local state ---
.docker-data/
pgdata/
neo4j-data/
minio-data/
kafka-data/
*.log

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
